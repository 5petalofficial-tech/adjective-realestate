{
  "name": "adjective-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND,ADMIN\" -c \"blue,green,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:admin\"",
    "dev:backend": "cd adjective-backend && npm run dev",
    "dev:frontend": "cd adjective-frontend && npm run dev",
    "dev:admin": "cd adjective-admin && npm run dev",
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "cd adjective-frontend && npm run build",
    "build:admin": "cd adjective-admin && npm run build",
    "kill": "taskkill /F /IM node.exe"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "leaflet": "^1.9.4",
    "mongodb": "^7.5.0",
    "openai": "^7.9.0",
    "react-leaflet": "^5.0.0",
    "twilio": "^6.1.0"
  }
}
